                  "descendants": {
                    "bccce": {
                      "content": "Активация поиска"
                    },
                    "RfqR8": {
                      "content": "Тап по полю «Поиск» (или оттягивание и тап)."
                    },
                    "epd02": {
                      "content": "Заголовок и папки уезжают вверх, поле встаёт под статус-бар, справа стеклянный крестик, капсулы-разделы проявляются, клавиатура."
                    },
                    "S6iKC": {
                      "content": "Системная анимация .searchable ~350 мс; капсулы fade 150 мс."
                    },
                    "jTKvt": {
                      "content": "Крестик или свайп вниз по списку — обратный путь, введённый запрос сбрасывается."
