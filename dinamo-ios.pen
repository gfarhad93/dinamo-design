                      "children": [
                        {
                          "type": "text",
                          "id": "UGIuN",
                          "name": "Caption title",
                          "fill": "$text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "S5.23a Видео · кнопки скрыты, своё окно перетаскивают · флаги вкл.",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "E2WGA",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Автоскрытие (флаг callControlsAutoHide): через 3000 мс после последнего действия шапка, кнопки и затемнения гаснут (фейд 200 мс). Таймер сбрасывает любое касание, открытое меню, перетаскивание, лист разрешения и фокус VoiceOver внутри кнопок — пока фокус там, не прячем; пока нет видео собеседника и при плашке-предупреждении — тоже. Первое касание скрытого экрана только показывает кнопки. Флаг выкл. — кнопки видны всегда (S5.23). Перетаскивание своего окна в 1:1 (флаг selfViewDraggable1to1): зона = экран минус шапка со «Свернуть» и именем, кнопки (даже скрытые), клавиатура и системные отступы; отпустили — прилипает к ближайшему свободному углу зоны (spring 0.35/0.78), угол сохраняется при повороте; VoiceOver — действие «Переместить в угол…» (правый верхний / левый нижний / правый нижний). Флаг выкл. — окно закреплено справа сверху, как сейчас.",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
