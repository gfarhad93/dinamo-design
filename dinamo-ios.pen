              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Пружины SwiftUI (response / dampingFraction), длительности в секундах. Каждое движение — с фолбэком Reduce Motion и местом фокуса VoiceOver; хаптики — UIFeedbackGenerator.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "Z7nBPX",
              "name": "Cards row",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "id": "sQ3e9",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Аватар: шапка чата → профиль",
                  "descendants": {
                    "bccce": {
                      "content": "Аватар: шапка чата → профиль"
                    },
                    "RfqR8": {
                      "content": "Тап по капсуле в шапке чата (S3) или по аватару автора в группе."
                    },
                    "epd02": {
                      "content": "Аватар 36 из капсулы растёт до 104 и встаёт в центр шапки (matchedGeometryEffect), имя перелетает под него, остальное поднимается на 12 pt с fade."
                    },
                    "S6iKC": {
                      "content": "Push 0,35 · spring 0.35/0.85; тексты — fade 0,2 с задержкой 0,08"
                    },
                    "jTKvt": {
                      "content": "Свайп назад — аватар пропорционально возвращается в капсулу; отпустили до 50 % — остаёмся в профиле"
                    },
                    "G5uKG3": {
                      "content": "Имя в шапке профиля"
                    },
                    "SZwxj": {
                      "content": "Crossfade 0,2 без перелёта и подъёма"
                    }
                  }
                },
                {
                  "id": "kTb2L",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Шапка тянется",
                  "descendants": {
                    "bccce": {
                      "content": "Шапка тянется"
                    },
                    "RfqR8": {
                      "content": "Оттягивание списка вниз от верха (overscroll)."
                    },
                    "epd02": {
                      "content": "Аватар масштабируется до 1,15× от верхнего края, свечение растёт вместе с ним; текст не масштабируется."
                    },
                    "S6iKC": {
                      "content": "Интерактивно; отпускание — spring 0.4/0.8"
                    },
                    "jTKvt": {
                      "content": "Отпустили — возврат к 1×"
                    },
                    "G5uKG3": {
                      "content": "Не меняется"
                    },
                    "SZwxj": {
                      "content": "Без масштаба — обычный bounce списка"
                    }
                  }
                },
                {
                  "id": "wrCzn",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Шапка сворачивается",
                  "descendants": {
                    "bccce": {
                      "content": "Шапка сворачивается"
                    },
                    "RfqR8": {
                      "content": "Прокрутка вверх, шапка уходит под навбар."
                    },
                    "epd02": {
                      "content": "Аватар 1 → 0,6 и fade за первые 80 pt; когда имя скрылось на 70 %, его копия появляется в центре навбара; под навбаром — scroll edge effect."
                    },
                    "S6iKC": {
                      "content": "Привязано к прокрутке; заголовок навбара — crossfade 0,2"
                    },
                    "jTKvt": {
                      "content": "Прокрутка назад — всё в обратном порядке"
                    },
                    "G5uKG3": {
                      "content": "Не меняется (заголовок навбара читается при свайпе вверх по экрану)"
                    },
                    "SZwxj": {
                      "content": "Без масштаба, только crossfade заголовка"
                    }
