                    },
                    "S6iKC": {
                      "content": "Галочка: scale 0.8→1 — spring 0.3/0.7. Статус: crossfade 0,2 с. Закрытие — только по «Готово» (системная анимация расширения), без автозакрытия."
                    },
                    "jTKvt": {
                      "content": "✕ — cancelRequest: до записи очереди ничего не уходит. После «Готово» отменить нельзя — сообщения в очереди видны в чатах (S9.36)."
                    },
                    "G5uKG3": {
                      "content": "Фокус на заголовке листа; объявление «В очереди на отправку»."
                    },
                    "SZwxj": {
                      "content": "Галочка без масштаба, статус — fade."
                    }
                  }
                },
                {
                  "id": "Q8p9ys",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Лист «Ссылка регистрации» и алерты",
