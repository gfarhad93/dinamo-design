                {
                  "id": "IYUdd",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Открытие профиля",
                  "width": 960,
                  "descendants": {
                    "bccce": {
                      "content": "Открытие профиля"
                    },
                    "RfqR8": {
                      "content": "Тап по строке человека (список, поиск, iPad-колонка)."
                    },
                    "epd02": {
                      "content": "iPhone и compact-окно iPad: push S4.1, аватар 40 перелетает в шапку (104). Regular iPad: деталь заменяется на месте — crossfade 200 мс, без перелёта; фокус — на заголовок детали."
                    },
                    "S6iKC": {
                      "content": "Push 350 мс, spring 0.35/0.85"
                    },
                    "jTKvt": {
                      "content": "Свайп назад интерактивный (compact). Окно сузилось до compact — выбранный профиль остаётся открытым поверх списка"
                    },
                    "G5uKG3": {
                      "content": "На имя в шапке профиля; назад — на ту же строку"
