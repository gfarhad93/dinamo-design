            {
              "type": "text",
              "id": "oxyrA",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Триггер → что движется → длительность/пружина → запасной вариант для Reduce Motion. Системные переходы не переопределяем.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "coviT",
              "name": "Cards row",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "id": "bir7o",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Смена вкладки",
                  "width": "fill_container",
                  "descendants": {
                    "bccce": {
                      "content": "Смена вкладки"
                    },
                    "RfqR8": {
                      "content": "Любой корень вкладки; тап по вкладке таб-бара или пункту боковой панели (iPad)."
                    },
                    "epd02": {
                      "content": "Контент вкладки меняется сразу, её стек навигации сохраняется. Линза выбора перетекает к новой вкладке, символ становится .fill."
                    },
                    "S6iKC": {
                      "content": "Контент — без анимации (как в системе), линза — системная пружина Liquid Glass."
                    },
                    "jTKvt": {
                      "content": "Нет — действие мгновенное."
                    },
                    "G5uKG3": {
                      "content": "На заголовок новой вкладки."
                    },
                    "SZwxj": {
                      "content": "Линза переставляется без перетекания."
                    }
                  }
                },
                {
                  "id": "ZxiPR",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Повторный тап по вкладке «Чаты»",
                  "width": "fill_container",
                  "descendants": {
                    "bccce": {
                      "content": "Повторный тап по вкладке «Чаты»"
                    },
                    "RfqR8": {
                      "content": "Список прокручен вниз; тап по уже выбранной вкладке."
                    },
                    "epd02": {
                      "content": "Прокрутка наверх и раскрытие большого заголовка; если уже наверху — ничего (поиск не активируем)."
                    },
                    "S6iKC": {
                      "content": "Системная прокрутка ~300 мс, ease-out."
                    },
                    "jTKvt": {
                      "content": "Касание списка останавливает прокрутку на месте."
                    },
                    "G5uKG3": {
                      "content": "На первую строку списка."
                    },
                    "SZwxj": {
                      "content": "Мгновенный переход наверх."
                    }
                  }
                },
                {
                  "id": "KHPoM",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Список → чат",
                  "width": "fill_container",
                  "descendants": {
                    "bccce": {
                      "content": "Список → чат"
                    },
                    "RfqR8": {
                      "content": "S2.1/S2.2; тап по строке (подсветка $surface-low 100 мс)."
                    },
                    "epd02": {
                      "content": "Push экрана чата, таб-бар уезжает вместе со списком; строка помечается прочитанной, когда чат открылся."
                    },
                    "S6iKC": {
                      "content": "Push 350 мс, spring 0.35/0.85."
                    },
                    "jTKvt": {
                      "content": "Интерактивный свайп от левого края: отпустить до 50 % — возврат в чат."
                    },
                    "G5uKG3": {
                      "content": "На заголовок чата (имя в навбаре)."
                    },
                    "SZwxj": {
                      "content": "Crossfade 200 мс без сдвига."
                    }
                  }
                },
                {
                  "id": "z6ixp",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Сворачивание большого заголовка",
                  "width": "fill_container",
                  "descendants": {
                    "bccce": {
                      "content": "Сворачивание большого заголовка"
                    },
                    "RfqR8": {
                      "content": "Список наверху; прокрутка вниз на ≥ 1 строку."
                    },
                    "epd02": {
                      "content": "«Чаты» 34 → 17 в навбаре, поиск и капсулы уходят под панель, ленту под стеклом гасит scroll edge effect; появляется подзаголовок папки."
                    },
                    "S6iKC": {
                      "content": "Привязано к прокрутке (не по времени), докатка системная."
                    },
                    "jTKvt": {
                      "content": "Прокрутка вверх возвращает в любой момент."
                    },
                    "G5uKG3": {
                      "content": "Не меняется."
                    },
                    "SZwxj": {
                      "content": "Так же — движение идёт за пальцем."
                    }
