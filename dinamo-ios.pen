          "gap": 28,
          "children": [
            {
              "type": "text",
              "id": "UFxG4",
              "name": "Label",
              "fill": "$accent",
              "content": "КОМПОНЕНТЫ БЛОКА",
              "fontFamily": "Inter",
              "fontSize": 13,
