                    "RfqR8": {
                      "content": "Свайп влево по строке > 10 pt."
                    },
                    "epd02": {
                      "content": "Строка едет за пальцем, справа раскрываются «Видео», «Позвонить», «Написать» по 74 pt; дальше 60 % ширины — полный свайп, «Написать» на всю строку."
                    },
                    "S6iKC": {
                      "content": "За пальцем; доводка spring 0.3/0.9; хаптик .medium на пороге"
                    },
                    "jTKvt": {
                      "content": "Свайп обратно или тап мимо"
