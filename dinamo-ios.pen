                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "G3ZWs",
                      "name": "Text",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "В превью долгого нажатия — поле «Ответить», отправка без открытия чата и без отметки «прочитано» для остальных сообщений. Работает на существующем API отправки.",
                      "lineHeight": 1.45,
