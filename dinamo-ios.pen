                              "type": "text",
                              "id": "pnc5h",
                              "name": "P",
                              "fill": "$on-avatar",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "1.2. Поставка осуществляется в три этапа в сроки, указанные в графике поставки (Приложение 2).",
                              "lineHeight": 1.45,
                              "fontFamily": "Inter",
                              "fontSize": 7.5,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "VY7lt",
                              "name": "P",
                              "fill": "$on-avatar",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "2. ЦЕНА И ПОРЯДОК РАСЧЁТОВ",
                              "lineHeight": 1.45,
