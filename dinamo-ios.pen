    {
      "type": "frame",
      "id": "SNpGT",
      "x": 1720,
      "y": 3407,
      "name": "06 Баблы · Заряд",
      "theme": {
        "Mode": "Dark"
      },
      "width": 1800,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 56,
      "padding": 64,
      "children": [
        {
          "type": "frame",
          "id": "k88PK",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "z194ko",
              "name": "Title",
              "fill": "$text",
              "content": "06 · Баблы — «Заряд» (iOS)",
              "fontFamily": "Inter",
              "fontSize": 40,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "bveZ0",
              "name": "Note",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1100,
              "content": "«Заряд»: серия своих сообщений заряжается к последнему. Ранние — спокойный #0E52B8, предпоследнее — #1259C4, последнее — градиент #1A68D6 → #1663D0 со свечением и хвостом. У входящих последний пузырь чуть светлее и тоже с хвостом. Одного взгляда хватает, чтобы понять, где кончается серия и какое сообщение свежее. Форма угла показывает позицию в серии: внутренние углы со стороны отправителя — 5, внешние — 18.",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "YB9gD",
          "name": "Row 1",
          "width": "fill_container",
          "gap": 64,
          "children": [
