            {
              "type": "text",
              "id": "FUztP",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Пружины SwiftUI (response / dampingFraction), длительности в секундах. Каждое движение — с фолбэком Reduce Motion и местом фокуса VoiceOver; хаптики — UIFeedbackGenerator. Сетевые действия: кнопка показывает спиннер на время запроса, результат — только после ответа сервера (без оптимистичного «готово»).",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "M5sfSs",
              "name": "Cards row",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "id": "YT8cD",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Открытие документа",
                  "descendants": {
                    "bccce": {
                      "content": "Открытие документа"
                    },
                    "RfqR8": {
                      "content": "Тап по строке списка (S7.1), push-уведомлению или карточке в чате (S7.72).",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "epd02": {
                      "content": "Push карточки; плитка типа и название летят из строки в шапку (matchedGeometryEffect). Открыто из push-уведомления — источника нет: стандартный push без перелёта.",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "S6iKC": {
                      "content": "spring 0.35/0.85 — одна пружина для push и перелёта",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "jTKvt": {
                      "content": "Свайп от края — интерактивный возврат; отпустили до 50 % — остаёмся в карточке документа",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "G5uKG3": {
                      "content": "Заголовок документа (title1)",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "SZwxj": {
                      "content": "Crossfade 0,2 без перелёта плитки",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    }
                  }
                },
                {
                  "id": "cxRLf",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Лист подписи",
                  "descendants": {
                    "bccce": {
                      "content": "Лист подписи"
                    },
                    "RfqR8": {
                      "content": "«Подписать» в панели действий (S7.13).",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "epd02": {
                      "content": "Лист снизу до detent ≈ 0,7; фон затемняется до scrim; панель действий уходит под лист.",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "S6iKC": {
                      "content": "spring 0.35/0.9 (лист); затемнение следует за положением листа",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "jTKvt": {
                      "content": "Свайп вниз / «×» — закрыть без подписи; во время «Подписываем…» закрыть нельзя",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
