              "type": "text",
              "id": "kzfYB",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Входящий 1:1 на iOS — системный экран CallKit (решение проекта): на экране блокировки и баннером поверх приложения. Мы его не рисуем и не меняем — здесь только референс того, что передаём системе: имя собеседника, подпись приложения «Динамо», тип (аудио/видео), значок приложения. После ответа открывается наш экран: «Соединение…» (S5.14) → разговор (S5.15 / S5.23). Отклонение — в истории «Пропущенный»/«Отклонён». На Android — свой полноэкранный экран входящего (доска Android S5).",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
