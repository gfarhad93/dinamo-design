                      "content": "Заголовок листа «Подписать документ»",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    },
                    "SZwxj": {
                      "content": "Fade листа 0,2, без пружины",
                      "textGrowth": "fixed-width",
                      "width": "fill_container"
                    }
                  }
                },
                {
                  "id": "drOLP",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Подпись: успех",
                  "descendants": {
                    "bccce": {
                      "content": "Подпись: успех"
                    },
                    "RfqR8": {
                      "content": "Ответ сервера «подпись создана» (S7.36 → S7.37).",
