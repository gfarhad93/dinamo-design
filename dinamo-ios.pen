                        {
                          "type": "text",
                          "id": "zwsK9",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Баннер приходит сверху (системный, ~5 с, свайп вверх — убрать, вниз — развернуть). Метка на значке приложения: число непрочитанных во всех чатах, кроме заглушённых (BadgeManager, excludeMuted). ЭДО и пропущенные звонки в метку не входят — у них бейджи вкладок. Обновляют: NSE при каждом пуше, приложение — при чтении и синхронизации; выход из аккаунта — 0. Тап по баннеру → чат, как S9.21.",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
