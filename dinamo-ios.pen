            {
              "type": "text",
              "id": "LytqR",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Push из капсулы группового чата (S3.13) или из списка чатов. Шапка: фото, название, «Группа · N участников», «Ваша роль: …» и описание. Плитки: Без звука, Поиск, Звонок, Пригласить. Ниже — уведомления и медиа, блок «Управление» (только владельцу и администраторам с правами — строки, на которые нет права, скрыты), участники (первые 10 + «Показать всех») и опасные действия внизу. Одинаково на iOS и Android; на iOS правка — лист «Изменить», на Android — экран.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
