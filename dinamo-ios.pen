              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "pLXmA",
              "name": "Purpose",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1000,
              "content": "Палитра Динамо для iOS: светлая и тёмная тема на одних и тех же семантических токенах. В коде токены живут в DynamoDesignSystem/ColorTokens.swift и подставляются через Asset Catalog (Any / Dark), поэтому интерфейс меняет тему вместе с системой. Бренд-синий #044CA8 остаётся у логотипа и иконки. Цвета пузырей — шкала «Заряд» (out-charge-1/2, out-charge-top/last, bubble-in-1/last, glow) — на доске 06.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
