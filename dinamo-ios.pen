              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "iPad 1180×820, горизонтально: NavigationSplitView — боковая панель со списком чатов (стеклянная, плавающая), чат по центру, по кнопке «i» или тапу по капсуле — инспектор справа вместо push в профиль. Медиа открываются на весь экран с той же логикой, что на iPhone.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
