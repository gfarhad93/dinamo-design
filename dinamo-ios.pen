                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "Fdjez",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "«Поделиться» → UIActivityViewController (системный, рисуем для контекста). Текст честный для человека без приложения, одинаковый на обеих платформах: «Установите Динамо из App Store или Google Play и при регистрации введите код 7KQ4M2XD» + ссылка https://dinamoedo.online/register/7KQ4M2XD (веб-страница по ссылке — в «Предложениях»). Получатели и приложения — системные. Закрыли или отправили — возвращаемся в S6.26; результат отправки не показываем. Сейчас в коде iOS текст «Приглашаю вас в Dinamo. Код приглашения: …» — заменить.",
                          "lineHeight": 1.45,
