                      "gap": 4,
                      "children": [
                        {
                          "type": "text",
                          "id": "HTITY",
                          "name": "Caption title",
                          "fill": "$text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "S1.39 iPad · вход с клавиатурой",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "wwMZx",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": 900,
                          "content": "Экранная клавиатура в альбомной ориентации (≈ 398 pt). Карточка в ScrollView: верх не ближе 24 pt к статус-бару; содержимое прокручено так, что «Войти» видна над клавиатурой (≥ 16 pt), шапка уходит под край с затуханием. Смена фокуса прокручивает к полю; закрыли клавиатуру — карточка возвращается в центр (кривая клавиатуры). Аппаратная клавиатура — без сдвига.",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
