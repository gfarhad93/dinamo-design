                    {
                      "type": "text",
                      "id": "vdyNA",
                      "name": "Rule",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Приоритет подзаголовка: связь → набор («печатает…») → присутствие. Смена — crossfade 0,2 с, без сдвига капсулы. В группе — те же строки вместо «14 участников». На AX-размерах статус переносится на свою строку под именем (S3.68), но не скрывается. VoiceOver: статус входит в подпись кнопки-капсулы.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
