                        },
                        {
                          "type": "text",
                          "id": "TOE55",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Основное состояние видеозвонка. Имя и таймер — белым поверх затемнения (контраст ≥ 4,5:1 на любом кадре), качество — бейдж с полосами (то же слово, что в аудио). «Вы» — своё видео, зеркально. «Поворот» — фронтальная/основная камера, кроссфейд 250 мс. «Свернуть» (новое на iOS, как на Android) → мини-окно S5.50; уход из приложения — системный PiP S5.52. С флагом callControlsAutoHide через 3 с без касаний → S5.23a; без флага кнопки видны всегда.",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
