                    "bccce": {
                      "content": "Активация поиска"
                    },
                    "RfqR8": {
                      "content": "S6.1: тап по полю или ⌘F."
                    },
                    "epd02": {
                      "content": "Заголовок и «Пригласить коллег» уезжают вверх с fade, поле встаёт под статус-бар, справа появляется стеклянная «Отмена» (slide + fade), клавиатура."
                    },
                    "S6iKC": {
                      "content": "Spring 0.35/0.9 ≈ 0,35 с; клавиатура — системная"
                    },
                    "jTKvt": {
                      "content": "«Отмена» — выход и очистка запроса; прокрутка результатов только прячет клавиатуру"
                    },
                    "G5uKG3": {
                      "content": "На поле поиска; при выходе — снова на поле"
                    },
                    "SZwxj": {
                      "content": "Crossfade 0,2 с без сдвига"
                    }
                  }
                },
                {
                  "id": "YbDNY",
