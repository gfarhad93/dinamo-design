              "layout": "vertical",
              "gap": 10,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "z1uaSO",
                  "name": "• iOS · ЭДО: при подписани",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  iOS · ЭДО: при подписании отправляется неверный certificateId; «Отклонить» ставит документу статус Archive; причина отклонения не уходит на сервер.",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "orzCX",
                  "name": "• iOS · Share Extension: п",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  iOS · Share Extension: подпись прикрепляется к каждому фото, а не к первому; очередь пишется по одному элементу — сбой на втором всё равно отправляет первый.",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "codzT",
                  "name": "• iOS · быстрый ответ из у",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  iOS · быстрый ответ из уведомления при ошибке падает молча (только запись в лог).",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "LrGTb",
                  "name": "• Android · быстрый ответ ",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Android · быстрый ответ из уведомления уходит без шифрования и без подтверждения сервера; текст Lock Mode показывается в уведомлении расшифрованным. Решение дизайна: Lock Mode в уведомлениях — «Защищённое сообщение», без текста и без быстрого ответа, на обеих платформах.",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "vXnl0",
                  "name": "• Android · «Поделиться» б",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Android · «Поделиться» без входа молча теряет файл.",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JWojR",
                  "name": "• Сервер · пуши ЭДО не отп",
                  "fill": "$text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Сервер · пуши ЭДО не отправляются: edo::notifications::create_notification нигде не вызывается.",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
