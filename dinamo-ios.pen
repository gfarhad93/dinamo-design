            {
              "type": "text",
              "id": "c7k1Ct",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Все движения звонка: что запускает, что двигается, тайминги/пружины, что делает отмена, куда идёт фокус VoiceOver и что остаётся при Reduce Motion. Пружины — SwiftUI .spring(response, dampingFraction).",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "ewxRu",
              "name": "Cards row",
              "width": "fill_container",
              "gap": 24,
              "children": [
                {
                  "id": "xyo4u",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Исходящий → разговор",
                  "width": "fill_container",
                  "descendants": {
                    "bccce": {
                      "content": "Исходящий → разговор"
                    },
                    "RfqR8": {
                      "content": "Экран «Вызов…» (S5.12), собеседник ответил."
                    },
                    "epd02": {
                      "content": "Пульс колец гаснет (300 мс), кольцо «застывает» на «Соединение…», затем статус кроссфейдом меняется на таймер 0:00, вокруг аватара появляется «дыхание» по уровню голоса."
                    },
                    "S6iKC": {
                      "content": "Кольца 1,6 с ease-out ∞; кроссфейд статуса 200 мс; дыхание — следует за уровнем, сглаживание 120 мс."
                    },
                    "jTKvt": {
                      "content": "«Завершить» до ответа — экран сразу закрывается (dismiss 300 мс), итог не показывается."
                    },
                    "G5uKG3": {
                      "content": "Объявление «Соединение установлено», фокус остаётся на «Завершить»/последней кнопке."
                    },
                    "SZwxj": {
                      "content": "Колец и дыхания нет: статичный аватар, только смена текста."
                    }
                  }
                },
                {
                  "id": "H8qlWa",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Экран звонка → мини-окно",
