            {
              "type": "text",
              "id": "u3rEUM",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Звонок идёт, а экран звонка закрыт (перешли в чат по пушу или ссылке, открыли другое приложение). В приложении — плавающее стеклянное мини-окно (перетаскивается, прилипает к ближайшему краю): «Активный звонок · Аудио/Видео», имя, таймер, «Коснитесь, чтобы вернуться», «Завершить». Вне приложения видеозвонок уходит в системный PiP, аудио — в зелёный индикатор системы. Плашка «Идёт звонок» в чате группы — в S3.13.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
