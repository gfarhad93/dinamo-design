                    {
                      "type": "frame",
                      "id": "XGNr8",
                      "name": "Caption",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 4,
                      "children": [
                        {
                          "type": "text",
                          "id": "nO6bz",
                          "name": "Caption title",
                          "fill": "$text",
                          "content": "S10.7 Групповой звонок · чат в панели",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "bPdZ8",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Из S5.56: кнопка «Чат» (message, 44 pt) в стеклянной шапке звонка; на ней — красная точка, пока в чате группы есть непрочитанные. Панель 320 (непрозрачная, контент) переключается сегментами «Участники · 6 / Чат»; кнопки «Участники» и «Чат» в шапке открывают нужный сегмент, повторный тап закрывает панель. Чат — та же переписка группы, что в S3 (не отдельный чат звонка — сервер не меняется); если у звонка нет группового чата, сегмента «Чат» нет. Поле ввода — как в чате (вложения, Lock Mode, ↩ — отправить); клавиатура сама не открывается, фокус VoiceOver — на сегментах. Звук звонка не прерывается; ⌘D / ⌘E — микрофон и камера, когда фокус не в поле. Плитки ужимаются до 796, сетка 3 × 2 сохраняется. W < 864 — панель становится листом .medium / .large поверх звонка. На Android панель 360 dp (side sheet) — разница платформ.",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
