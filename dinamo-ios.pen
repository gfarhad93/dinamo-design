            {
              "type": "text",
              "id": "WvSOC",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Пружины SwiftUI (response / dampingFraction), длительности в секундах. Каждое движение проверяет Reduce Motion и имеет замену без перемещения. Слева — карточки движения (экземпляры Motion card с доски 10), справа — логика веток: старт, условие, отмена, фокус.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
