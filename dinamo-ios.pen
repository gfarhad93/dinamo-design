                              "type": "text",
                              "id": "F5xVz",
                              "name": "P",
                              "fill": "$on-avatar",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "1.1. Поставщик обязуется поставить, а Покупатель — принять и оплатить складское оборудование (стеллажи, погрузчики, упаковочные линии) согласно Спецификации (Приложение 1).",
                              "lineHeight": 1.45,
                              "fontFamily": "Inter",
                              "fontSize": 7.5,
                              "fontWeight": "normal"
                            },
