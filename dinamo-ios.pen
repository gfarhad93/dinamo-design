                        {
                          "type": "text",
                          "id": "z80fui",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Из S10.1: тап по «Анна Соколова», затем «i» в навбаре, тап по капсуле с именем или ⌥⌘I. W = 1180 ≥ 1129 → список 340 + чат 511 + инспектор 320 (отступ 8, непрозрачный $surface-low — это контент). Панель вкладок свернулась в таб-бар сверху (стекло, по центру окна), кнопка sidebar.left слева её возвращает — тогда инспектор закрывается. Инспектор: S10/Inspector header «Информация» + «×» (44 pt), аватар, статус, быстрые действия, контакты, «Сверка ключей шифрования · Проверено 1 из 2 устройств» (→ сверка ключей S3.65–S3.66 в колонке инспектора, «‹ Информация»), медиа; для группы — участники и роли (S4.67), для канала — подписчики. Чат ужимается без прыжка ленты (якорь — последнее видимое сообщение), пузыри ≤ 480. Открытие — .inspector, столбец выезжает справа 0,3 с spring 0.35/0.9; «×», Esc или ⌥⌘I — закрыть, фокус VoiceOver возвращается на кнопку «i».",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
