                    {
                      "type": "frame",
                      "id": "lFJbK",
                      "name": "Caption",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 4,
                      "children": [
                        {
                          "type": "text",
                          "id": "FR7MC",
                          "name": "Caption title",
                          "fill": "$text",
                          "content": "S10.7a Звонок · чат и экранная клавиатура",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "R8CrP",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Из S10.7: тап в поле панели «Чат» без аппаратной клавиатуры. Экранная клавиатура iPad (≈ 398 pt в альбомной) занимает низ окна; ужимается сцена звонка: сетка 3 × 2 сохраняется, плитки уменьшаются до ≈ 95 pt по высоте (видео не останавливаем), строка кнопок поднимается над клавиатурой и остаётся целиком видимой и нажимаемой. Панель «Чат» укорачивается до верхнего края клавиатуры: поле ввода — сразу над клавиатурой, последнее сообщение видно (лента прижата к низу), старые уходят вверх с прокруткой. Скрыть клавиатуру: клавиша скрытия на клавиатуре, свайп вниз по ленте (scrollDismissesKeyboard .interactively), тап по сцене звонка; Esc — на аппаратной клавиатуре. С аппаратной клавиатурой экранная не появляется — раскладка S10.7. Анимация — системная вместе с клавиатурой (keyboardLayoutGuide); Reduce Motion — без изменений.",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
