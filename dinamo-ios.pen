          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "oGIf2",
              "name": "Title",
              "fill": "$text",
              "content": "10 · Анимации — iOS",
              "fontFamily": "Inter",
              "fontSize": 40,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "ViK3M",
              "name": "Purpose",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "Движение короткое и объясняет, что произошло; на частых действиях — минимум. Пружины SwiftUI (response / dampingFraction), длительности в секундах. Каждое движение проверяет UIAccessibility.isReduceMotionEnabled (в коде уже есть resolvedStandard()/resolvedQuick()) и имеет замену без перемещения.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "L4Tl1w",
          "name": "Hero · Передача заряда",
          "width": "fill_container",
