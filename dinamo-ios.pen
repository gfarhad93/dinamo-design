            },
            {
              "type": "text",
              "id": "L1fPiq",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Звонки на iOS — только CallKit (VoIP-пуш → системный экран), обычных уведомлений о звонке мы не показываем. Документы ЭДО — 6 категорий из EDONotificationCategories; заголовок и текст присылает сервер ЭДО (ниже — рекомендуемый формат), действия и плейсхолдер скрытого текста задаёт приложение.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "cebVq",
              "name": "Row 1",
              "gap": 40,
              "children": [
                {
                  "type": "frame",
