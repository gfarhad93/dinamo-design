                    },
                    "RfqR8": {
                      "content": "Ссылка регистрации при активной сессии (S9.23), ошибка подготовки (S9.19)."
                    },
                    "epd02": {
                      "content": "Системный алерт по центру поверх затемнения."
                    },
                    "S6iKC": {
                      "content": "Системная анимация UIAlertController."
                    },
                    "jTKvt": {
                      "content": "«Понятно» / «Закрыть»."
                    },
                    "G5uKG3": {
