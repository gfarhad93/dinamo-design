                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "1. ПРЕДМЕТ ДОГОВОРА",
                              "lineHeight": 1.45,
                              "fontFamily": "Inter",
                              "fontSize": 7.5,
                              "fontWeight": "700"
                            },
