          "gap": 28,
          "children": [
            {
              "type": "text",
              "id": "qDWLm",
              "name": "Label",
              "fill": "$accent",
              "content": "КРУПНЫЙ ШРИФТ (AX5) · ПАНЕЛИ",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "600",
              "letterSpacing": 0.5
            },
            {
              "type": "text",
              "id": "zvL51",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Фрагменты окна 1180 × 820 при самом крупном размере текста: инспектор чата, инспектор ЭДО, деталь настроек и панель чата в звонке. Ширины панелей не растут (320 / 504) — текст переносится, а не обрезается; панели прокручиваются. Заголовки панелей, таб-бар и кнопки навбара не растут (Large Content Viewer). Размеры AX5: большой заголовок 60, имя и основной текст 53, подписи 44, метки групп 40.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "i8YCJ",
              "name": "Row 1",
              "gap": 40,
              "children": [
                {
                  "type": "frame",
                  "id": "JPOT2",
                  "name": "Cell · S10.14 AX5 · инспектор чата (фрагмент)",
                  "width": 328,
                  "layout": "vertical",
                  "gap": 14,
                  "children": [
                    {
                      "type": "frame",
                      "id": "v3CgiK",
                      "name": "S10.14 AX5 · инспектор чата (фрагмент)",
                      "theme": {
                        "Mode": "Dark"
                      },
                      "clip": true,
                      "width": 328,
                      "height": 820,
                      "fill": "$bg",
                      "layout": "vertical",
                      "padding": [
                        8,
                        8,
                        8,
                        0
                      ],
