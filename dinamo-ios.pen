                      "descendants": {
                        "ljE76": {
                          "content": "Поле ввода растёт до 4 строк на AX-размерах, дальше прокрутка внутри; кнопки 44 pt прижаты к нижней строке."
                        }
                      }
                    },
                    {
                      "id": "gNP1c",
                      "type": "ref",
                      "ref": "KTXyq",
                      "name": "Spec",
                      "width": "fill_container",
                      "descendants": {
                        "ljE76": {
                          "content": "Карточки файла, опроса и голосового занимают всю ширину пузыря; имя файла переносится, не обрезается до 1 строки."
                        }
                      }
                    },
                    {
                      "id": "BGPWi",
                      "type": "ref",
                      "ref": "KTXyq",
                      "name": "Spec",
                      "width": "fill_container",
                      "descendants": {
                        "ljE76": {
                          "content": "Иконки масштабируются вместе с текстом (SF Symbols + .font), но не больше 1.5×; зоны нажатия ≥ 44 pt."
                        }
