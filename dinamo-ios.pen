                        },
                        {
                          "type": "text",
                          "id": "I1jb2E",
                          "name": "Caption title",
                          "fill": "$text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "S6.3 Контакты · прокрутка, указатель",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "aUNTo",
                          "name": "Caption text",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Палец на «М» в указателе: список прыгает к букве без анимации, заголовок буквы закреплён под навбаром, на каждой смене буквы — хаптик .selection. Ведение пальцем — скраб; «•» — свёрнутые буквы. Разметка зон: голубой — зона указателя 44 × 366 pt (видимый 16 pt), оранжевый — 44 pt справа, которые оставляет каждая строка: текст и указатель не пересекаются. Точка — место касания, разметка в продукте не рисуется. Сортировка — русская (Ё = Е, латиница после кириллицы): Марина → Мария → Михаил. VoiceOver: регулируемый «Указатель разделов», свайп вверх/вниз меняет букву.",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
