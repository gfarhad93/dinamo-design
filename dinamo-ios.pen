            },
            {
              "type": "text",
              "id": "OeH8p",
              "name": "Desc",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Системные поверхности анимирует iOS — мы не меняем их тайминги. Ниже — только то, что рисует Динамо, и как это ведёт себя с VoiceOver и «Уменьшением движения».",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "bJzKJ",
              "name": "Row 1",
              "gap": 40,
              "children": [
                {
                  "id": "MM0RZ",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Тост",
                  "descendants": {
                    "bccce": {
                      "content": "Тост"
                    },
                    "RfqR8": {
                      "content": "Итог действия пользователя: скопировали, закрепили, отправили, архивировали; ошибка ручного повтора."
                    },
                    "epd02": {
                      "content": "Капсула S2/Toast снизу, 8 pt над таб-баром или полем ввода."
                    },
                    "S6iKC": {
                      "content": "Появление: смещение 12→0 pt и прозрачность 0→1 — spring 0.35/0.85. Уход: прозрачность → 0, 0,2 с easeIn. Видим 2 с / 4 с с действием / 10 с с VoiceOver; таймер на паузе при касании и фокусе VoiceOver."
                    },
                    "jTKvt": {
                      "content": "Свайп вниз — скрыть. Тост с действием не вытесняется тостом без действия (очередь). Отмена доступна и потом — в меню объекта."
                    },
                    "G5uKG3": {
                      "content": "Объявление текста (announcement), фокус не уводим; действие доступно через ротор."
                    },
                    "SZwxj": {
                      "content": "Только fade 0,2 с, без подъёма."
                    }
                  }
                },
                {
                  "id": "eLMI7",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Плашка состояния в списке",
                  "descendants": {
                    "bccce": {
                      "content": "Плашка состояния в списке"
                    },
                    "RfqR8": {
                      "content": "Сеть пропала / вернулась, началось или не удалось обновление (S9.25–S9.27)."
                    },
                    "epd02": {
                      "content": "Плашка первым элементом списка; строки ниже сдвигаются."
                    },
                    "S6iKC": {
                      "content": "Появление: высота 0→авто и прозрачность — 0,25 с easeOut. Смена текста — crossfade 0,2 с. Уход: высота → 0 и прозрачность — 0,25 с easeIn; строки списка следуют за высотой плашки (своей пружины нет)."
                    },
                    "jTKvt": {
                      "content": "Нет: уходит сама после успешного обновления. «Повторить» — спиннер в кнопке."
                    },
                    "G5uKG3": {
                      "content": "Объявляем «Нет соединения» и «Не удалось обновить…»; «Обновление…» молча."
                    },
                    "SZwxj": {
                      "content": "Без сдвига: плашка появляется и уходит fade 0,2 с, список перестраивается без анимации."
                    }
                  }
                },
                {
                  "id": "kokyV",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Подзаголовок капсулы чата",
                  "descendants": {
                    "bccce": {
                      "content": "Подзаголовок капсулы чата"
                    },
                    "RfqR8": {
                      "content": "Смена состояния связи в открытом чате."
                    },
                    "epd02": {
                      "content": "«в сети» ↔ «Ожидание сети…» ↔ «Соединение…» ↔ «Обновление…»."
                    },
                    "S6iKC": {
                      "content": "Текст — crossfade 0,2 с. Ширина капсулы — spring 0.3/0.9."
                    },
                    "jTKvt": {
                      "content": "—"
                    },
                    "G5uKG3": {
                      "content": "Новое значение входит в подпись капсулы; отдельно не объявляем, кроме «Ожидание сети…»."
                    },
                    "SZwxj": {
                      "content": "Crossfade без анимации ширины."
                    }
                  }
                },
                {
                  "id": "x0WXV",
                  "type": "ref",
                  "ref": "j2ivfh",
                  "name": "Motion · Открытие из уведомления",
                  "descendants": {
                    "bccce": {
                      "content": "Открытие из уведомления"
                    },
                    "RfqR8": {
                      "content": "Тап по уведомлению, баннеру или действию «Просмотреть»."
                    },
                    "epd02": {
                      "content": "Нужный чат (или карточка ЭДО) поверх своей вкладки, лента на сообщении, строка подсвечена (S9.21)."
                    },
                    "S6iKC": {
                      "content": "Переход — стандартный push навигационного стека iOS (системная кривая и длительность, без своих значений); при холодном старте — без анимации, экран сразу. К сообщению — без прокрутки-анимации. Подсветка: прозрачность 0.18→0, 1,2 с easeOut."
                    },
                    "jTKvt": {
                      "content": "«Назад» — в список чатов (стек: вкладка → чат)."
                    },
                    "G5uKG3": {
                      "content": "Фокус на подсвеченном сообщении."
                    },
                    "SZwxj": {
                      "content": "Подсветка статична 1 с, затем fade 0,3 с."
                    }
                  }
                }
              ]
            },
            {
              "type": "frame",
