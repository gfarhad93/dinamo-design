                    },
                    "RfqR8": {
                      "content": "Касание указателя (зона 44 pt) и ведение пальцем."
                    },
                    "epd02": {
                      "content": "Список прыгает к букве без анимации прокрутки, заголовок буквы закреплён, фон указателя $hairline на время касания."
                    },
                    "S6iKC": {
                      "content": "Мгновенно; хаптик .selection на каждой смене буквы"
                    },
                    "jTKvt": {
                      "content": "Отпустили палец — фон гаснет за 0,15 с"
                    },
                    "G5uKG3": {
                      "content": "Регулируемый «Указатель разделов»: свайп вверх/вниз — буква, объявляется буква"
                    },
                    "SZwxj": {
                      "content": "Без изменений — движения нет"
                    }
