                    {
                      "type": "text",
                      "id": "T6yALx",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Флаг selfViewDraggable1to1 (по умолчанию выкл. = как сейчас: превью неподвижно справа внизу над кнопками). Вкл.: превью «Вы» тянется пальцем (scale 1.04), при отпускании прилипает к ближайшему свободному углу допустимой зоны = экран минус шапка, панель кнопок, клавиатура и системные отступы (16dp от краёв); угол сохраняется после поворота экрана и между звонками в рамках сеанса. Контуры углов — только во время перетаскивания. TalkBack: действия «Переместить в левый верхний угол», «…в правый верхний», «…в левый нижний», «…в правый нижний» без перетаскивания. Двойное касание — сменить камеру.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
