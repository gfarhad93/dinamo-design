                    {
                      "type": "text",
                      "id": "ZXClP",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Кто-то начал звонок в группе (подписка callSignal): баннер выезжает сверху (M3 emphasized decelerate 400 мс), список остаётся рабочим. «Присоединиться» → S5.38. «Скрыть» (так же на iOS; на Android сейчас «Отклонить», хотя ничего не отправляет) прячет только баннер: инициатор ничего не получает, звонок остаётся доступным из полосы звонка в чате группы, пока он идёт. Без действия баннер уходит через 45 с (таймаут звонка, как сейчас). Полоска — оставшееся время. TalkBack: «Групповой звонок, Отдел продаж».",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
