                    {
                      "type": "text",
                      "id": "xxAqX",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Вход: шапка группового чата. В панели — информация группы с ролями и участниками; «Показать всех» открывает список участников в этой же панели (стрелка «Назад» в шапке панели). Шторки действий над участником — как на телефоне, но привязаны к панели (ширина 400dp, снизу панели); диалоги — по центру окна.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
