                    {
                      "type": "text",
                      "id": "BlzmA",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Публичные версии ЭДО-уведомлений — те же тексты, что скрытые превью iOS: «Требуется подпись», «Документ на рассмотрение», «Документ подписан», «Документ отклонён», «Новый комментарий», «Срок подписания истекает». Название документа и имена на экране блокировки не показываем, если включено «Скрывать конфиденциальное». Касание → разблокировка → карточка документа. Действия на экране блокировки скрыты.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
