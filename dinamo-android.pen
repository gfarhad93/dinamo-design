                        {
                          "type": "text",
                          "id": "JGKj5",
                          "name": "Rules",
                          "fill": "$text-2",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Не используем: HUD на весь экран, блокирующий спиннер поверх контента, индикатор без текста дольше 1 с. Индикатор появляется через 300 мс (быстрые ответы не мигают) и держится минимум 500 мс. Первая загрузка без кэша — скелетоны (S2.6, S6.21, S7). Длинная операция (загрузка файла) — линейный прогресс с процентами в своей строке. Дольше 10 с — подпись «Это занимает больше времени, чем обычно» и «Отменить», где отмена безопасна; нет ответа 15 с у необратимого действия — экран «результат неизвестен» (как iOS).",
                          "lineHeight": 1.45,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
