                    {
                      "type": "text",
                      "id": "eyoLu",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Системный вид — кнопки рисует Android, приложение задаёт только данные: имя, аватар, тип звонка. Свайп шторки: уведомление CallStyle канала «Текущий звонок» (беззвучное) — «Анна Соколова», «Идёт разговор» + системный таймер, единственная кнопка «Завершить». Тексты по фазе: «Вызов…», «Соединение…», «Переподключаем…». Касание уведомления → экран звонка. Для группового — заголовок «Групповой звонок».",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
