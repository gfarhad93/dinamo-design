                      "id": "iamJB",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Крупнейший размер шрифта (Android 14+ нелинейное масштабирование 200%: 12→24, 14→26, 16→28, 36→43). Строка растёт по высоте (132dp); превью — максимум 2 строки ВМЕСТЕ с префиксом отправителя, имя — 1 строка с «…» и обрезается раньше, чем сдвинет время и счётчик (защищённая правая колонка). Аватар 56 и значки статуса не масштабируются (dp). Папки — 44dp. Подписи вкладок ограничены 1,17× (14sp), полное имя читает TalkBack. FAB в большом шрифте всегда свёрнут в 56dp.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
