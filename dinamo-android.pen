                    {
                      "type": "text",
                      "id": "GnOdq",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Отложенная отправка (S9.26) не дождалась входа: прошло больше 24 ч или временная копия файла потеряна (очистка памяти, переустановка). После входа — плашка в начале списка чатов, как на iOS: «Фото не отправлено» (по виду: «2 фото не отправлены», «Файл не отправлен») · «Не удалось отправить: повторите отправку из приложения-источника.» и «Понятно» — убрать. Ничего не отправлено ни в один чат. Плашка — не снекбар: пользователь мог не смотреть на экран в момент входа.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
