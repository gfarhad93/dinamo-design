                    {
                      "type": "text",
                      "id": "ufXIg",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Тексты снекбаров совпадают с тостами iOS (оба снизу; iOS 2 / 4 с, с VoiceOver 10 с; Android — нормы M3: 4 и 10 с). Снекбар с действием не вытесняется новым без действия — ждёт в очереди; таймер стоит, пока на снекбаре палец или фокус TalkBack; действие продублировано в меню (например, «Вернуть из архива»). Обратимое — «Вернуть» / «Открепить», необратимое подтверждаем заранее и без «Отменить». Снекбар не сообщает о постоянном состоянии (сеть, сессия, устаревшие данные) — для этого плашки из матрицы. Действие без сети — «Нет сети — <действие> будет доступно после подключения».",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
