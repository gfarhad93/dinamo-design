                    {
                      "type": "text",
                      "id": "eM6vO",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "На планшете просмотрщик открывается поверх обоих pane на весь экран. Действия — в верхней панели справа (Ответить, Переслать, Сохранить, Поделиться, Удалить; подписи — в подсказках и TalkBack), лента миниатюр альбома — снизу по центру. Стрелки ← → и колесо мыши листают, Esc закрывает, Ctrl +/− — зум. Закрытие смахиванием и анимации — как на телефоне.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
