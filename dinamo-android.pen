                    {
                      "type": "text",
                      "id": "ui4lN",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "«Создать ссылку» → шторка: «Срок действия» и «Лимит переходов» — фильтр-чипы (одно значение), сводка выбранного, «Создать ссылку». Новая ссылка появляется в «Других ссылках» с подсветкой 1 с и снекбаром «Ссылка создана» + «Копировать». Ошибка — «Не удалось создать ссылку» + «Повторить». Сроки — как на iOS: бессрочно, 1 час, 24 часа, 7 дней, 30 дней (API принимает срок в часах). Уже вступившие по ссылке остаются в группе, когда она истечёт.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
