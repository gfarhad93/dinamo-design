                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Lock Mode включён, но у собеседника нет опубликованных ключей: отправка заблокирована (кнопка неактивна, 38%), над полем — подсказка «У Анны нет ключей Lock Mode» + «Подробнее» (экран о Lock Mode). Строка подсказки — 48dp, чтобы ссылка «Подробнее» имела касание 48dp внутри своей строки (бирюзовая рамка — зона касания, только в макете). Текст в поле сохраняется. Выход — выключить Lock Mode замком: при непустом черновике — подтверждение «Отправить без шифрования?» (S3.83) или подождать: когда ключи появятся, кнопка оживает без перезахода. TalkBack: «Отправить, недоступно: у получателя нет ключей».",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
