                    {
                      "type": "text",
                      "id": "vphiw",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Из «Недавних» в шторке вложений («Все фото» — системный Photo Picker: без разрешения, Android 13+). Шторка развёрнута на весь экран: сетка 3 колонки, касание — выбор с порядковым номером (primary-круг 24dp), повторное — снять. Сверху «Выбрано: 3», крестик закрывает без отправки. Внизу — «Просмотр» и «Отправить (3)». Частичный доступ (Android 14: только выбранные фото) — строка «Доступ к части фото · Изменить» над сеткой. TalkBack: «Фото 2 из 120, выбрано, номер 2».",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
