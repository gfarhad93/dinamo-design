                    {
                      "type": "text",
                      "id": "FT3Wu",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "«Права администратора» в шторке → экран «Права: Анна Соколова». Подпись — откуда права: «Сейчас действуют права по умолчанию для роли «Администратор»» или «Для этого участника заданы отдельные права». Переключатели 52×32 (вся строка — цель 48dp). Набор и порядок — как на сервере: изменять информацию, удалять сообщения, блокировать участников, приглашать, закреплять сообщения, добавлять администраторов, управлять звонками. Право, которого нет у вас, выключено (38%), нажатие — «Нельзя выдать право, которого нет у вас»; владелец может всё. По умолчанию у модератора — удалять, блокировать, закреплять, приглашать. «Сохранить» (как на iOS) — снекбар «Права сохранены»; «Вернуть права роли» — сброс к умолчаниям роли. В канале ещё «Публиковать записи» и «Редактировать чужие записи».",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
