                    {
                      "type": "text",
                      "id": "sGh68",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Нужна минимальная версия от сервера (в API её нет; например, поле в ответе на вход). Сервер включает требование только после того, как совместимая версия опубликована в каждом магазине (Google Play и App Store). Экран поверх всего приложения, без закрытия; «Назад» сворачивает приложение. «Открыть Google Play» — страница Динамо в Play; не открылась — S9.43a. «Связаться с поддержкой» → «Поддержка» из «О Динамо» (S8), как на iOS. При каждом возврате в приложение (ON_RESUME) версию проверяем снова: обновили — экран уходит сам. Идущий звонок не прерываем — экран появится после. Мягкий вариант — строка «Обновить» в Настройки → О Динамо. Тексты как на iOS (App Store → Google Play).",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
