                    {
                      "type": "text",
                      "id": "fZ4M2",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Пользовательские тексты причин вместо транспортных (relay, медиа, ICE); технический код — в третьей колонке для разработчиков. Одно состояние — один текст на iOS и Android. «answered» не терминальная: дошла до экрана — «Звонок завершён». «Отклонён» — нейтральный, красный — только сбои связи. Неудачные причины ждут действия только при включённом флаге endScreenStaysOnFailure.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
