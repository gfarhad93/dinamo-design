                    },
                    {
                      "type": "text",
                      "id": "XRSi0",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Успех: карточка превращается в секцию «Из телефонной книги» (container transform, высота — default spatial), снекбар «Нашли 5 коллег из телефонной книги» 4 с, TalkBack объявляет его. Под секцией — S6/Inline status · успех «Совпадения обновляются раз в сутки» + «Обновить» (ручное сравнение; автоматически — раз в 24 ч и при возврате в приложение после суток). Без анимаций — секция появляется сразу.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
