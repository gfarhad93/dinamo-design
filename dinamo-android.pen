            {
              "type": "text",
              "id": "QM6YC",
              "name": "Note",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Касание — профиль S4.1 (контейнерная трансформация строки). Долгое нажатие — шторка быстрых действий; те же действия есть в профиле и в меню действий TalkBack, жестом-only ничего нет. Свайпов в списке нет: на Android они не ожидаемы в контактах и конфликтуют с жестом «назад» у края.",
              "lineHeight": 1.5,
