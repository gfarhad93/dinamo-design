                    {
                      "type": "text",
                      "id": "XY5lg",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "⋮ в app bar → меню M3 (surface-high, 48dp пункты). «Обновить из телефонной книги» — повторное сравнение (без доступа пункт называется «Найти в телефонной книге» и ведёт к S6.11). «Пригласить коллег» — шторка S6.29. «Мои приглашения» — Настройки › Приглашения (S8). Меню: M3 fade + scale 0.8→1 от ⋮, пружина fast effects; закрытие — касание вне меню или «назад», фокус TalkBack возвращается на ⋮.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
