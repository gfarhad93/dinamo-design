                    {
                      "type": "text",
                      "id": "d5xSE3",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Скрепка → модальная шторка M3 ($surface-low, верх 28dp, scrim 32%). Сверху — недавние фото (сетка 4×2, касание выбирает и нумерует, «Все фото» открывает пикер S3.29), ниже — тональные кнопки 56dp: Фото и видео, Файл, GIF, Стикеры, Опрос, Геопозиция (новое, нужен бэкенд). Камеры и контакта нет — их нет в приложении. Разрешение на фото — по первому открытию; отказ — вместо сетки строка «Нет доступа к фото · Разрешить» (проверяем снова при возврате из настроек). Открытие — slide up 300 мс emphasized-decelerate; без анимаций — сразу; фокус TalkBack — на заголовке шторки.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
