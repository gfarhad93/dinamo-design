          "children": [
            {
              "type": "text",
              "id": "rVsYZ",
              "name": "Label",
              "fill": "$text-3",
              "content": "6 · ГЛОБАЛЬНЫЕ СОСТОЯНИЯ · ЕДИНЫЙ СПРАВОЧНИК",
              "fontFamily": "Inter",
              "fontSize": 13,
