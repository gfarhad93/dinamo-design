                    {
                      "type": "text",
                      "id": "MRRGr",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Шрифт 200% (нелинейное масштабирование Android 14+: 16 → 28, 14 → 26 sp). «Недавно на связи» из ленты становится вертикальными строками (те же люди, тот же порядок, до 8). Имя и вторая строка переносятся (до 3 строк, дальше многоточие), строка растёт по высоте, аватар 40dp не меняется. Заголовок «Контакты» в одну строку, подсказка поиска сокращается до «Имя, телефон…». Пузырь быстрой прокрутки — 96dp. Ничего не обрезается по ширине.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
