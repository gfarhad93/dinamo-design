                    {
                      "type": "text",
                      "id": "ETlCD",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Зоны нажатия (оранжевые): ⋮ 48, search bar 56 на всю ширину, строки 72, лента недавних 76×86 на человека, «Все · 5» — видимая 32, зона 48 (растёт вниз, не перекрывает строку). Голубая полоса — захват быстрой прокрутки 48dp у правого края: активна, только пока бегунок виден; в покое касание уходит строке. Вкладки навигации 64. Касательные зоны соседей не пересекаются.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
