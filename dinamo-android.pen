                    },
                    {
                      "type": "text",
                      "id": "VZJz7",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Снекбар — результат действия: свайп чата → «Чат перемещён в архив» + «Вернуть» (тексты как в тосте iOS). Кнопка возврата есть только у обратимых действий (архив — «Вернуть», закреп — «Открепить», без звука, прочитано); удаление чата остаётся подтверждением в диалоге (решение S2, S9.36) — сознательное отличие от задания, где было «удалено + Отменить». Снекбары с действием встают в очередь и не вытесняются более новым сообщением без действия; таймер (10 с, без действия 4 с) останавливается, пока палец на снекбаре или на нём фокус TalkBack. Возврат доступен и после: «Вернуть из архива» в меню чата в «Архиве». Над навигацией 12dp, FAB поднимается вместе с ним. Место — снизу на обеих платформах (как S2–S8): сознательное отличие от задания («тост сверху» на iOS).",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
