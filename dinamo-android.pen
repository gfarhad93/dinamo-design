                    {
                      "type": "text",
                      "id": "v8eQj",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Вход: свайп вниз от строки состояния. С ярлыками разговоров Android выносит чаты в раздел «Разговоры» над остальными уведомлениями; верхний разговор развёрнут: до 3 последних сообщений (MessagingStyle.addMessage), действия «Ответить», «Прочитано», «Без звука на 1 час». Канал «Новости компании» — без «Ответить», если писать в нём нельзя (не админ). Заглушённые чаты приходят тихо (канал «Сообщения без звука») и попадают в «Беззвучные». Разворот/сворачивание карточки — стрелка (48dp), анимацию делает система. «Очистить все» снимает уведомления, но не отмечает чаты прочитанными.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
