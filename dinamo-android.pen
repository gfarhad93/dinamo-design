              "fontWeight": "600",
              "letterSpacing": 0.6
            },
            {
              "type": "text",
              "id": "B0etO",
              "name": "Note",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Касание search bar → M3 search view на весь экран. Локальные секции (недавние, телефонная книга — в том числе по номеру телефона) фильтруются сразу; коллеги — запрос на сервер от 2 символов после паузы 300 мс, тайм-аут 10 с. Человек показывается один раз: найден в телефонной книге — в её секции. Совпадение в имени выделено primary + bold. Область поиска написана в пустом состоянии.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
