                    {
                      "type": "text",
                      "id": "c1YCM",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Групповой звонок «Отдел продаж», открыта вкладка «Чат». Сцена ужимается до 912 dp: сетка 3 + 3 сохраняет пропорции плиток, панель кнопок — по центру сцены. В панели — последние сообщения группы и поле ввода (тот же Composer dock: вложения и Lock Mode — как в чате). Новое сообщение, пока открыта вкладка «Участники» или панель закрыта, — бейдж на вкладке и на кнопке «Чат»; звук звонка не прерывается. Клавиатура не открывается сама; фокус TalkBack — на вкладках панели. Ctrl+D — микрофон, Ctrl+E — камера (S5.60), Enter — отправить, Esc — закрыть панель.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
