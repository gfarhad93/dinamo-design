                    },
                    {
                      "type": "text",
                      "id": "nzJUk",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Долгое нажатие (вибрация LONG_PRESS): фон — scrim 52% + размытие 12dp (Android 12+, ниже — только scrim); пузырь остаётся на месте и поднимается (углы 20, хвост втягивается, тень level3). Снизу места нет — меню и панель реакций (6 частых + «+») раскрываются над пузырём. Своё доставленное: Ответить, Копировать, Переслать, Закрепить, Изменить, Информация, Удалить. Lock Mode: без «Переслать» и «Изменить». Неотправленное: первым «Повторить отправку». Закрытие — тап мимо или Назад; фокус TalkBack — на первой реакции. Зоны касания: каждая реакция и «ещё» — 48×48 без перекрытий (панель 348dp); пилюли реакций под пузырём — 26 визуально, 48 по высоте за счёт запаса, который не налезает на соседнее сообщение.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
