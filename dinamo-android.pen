                    {
                      "type": "text",
                      "id": "x8rn3",
                      "name": "Caption",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "«Заблокировать» в профиле → диалог M3 (scrim 32%, диалог 312dp, extra-large 28). Текст нейтральный, без местоимений и без обещаний про звонки. Подтверждение красным. Успех — S4.7 и снекбар «Анна Соколова заблокирована». Ошибка сервера — снекбар «Не удалось заблокировать» + «Повторить» (ничего не изменилось). Нет ответа (таймаут) — «Не удалось проверить результат» + «Обновить»: профиль перечитывается, статус берём с сервера. Отмена/Назад/тап по scrim — закрыть, фокус TalkBack на «Заблокировать».",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
